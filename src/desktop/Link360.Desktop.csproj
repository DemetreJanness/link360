<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LINK360</AssemblyName>
    <Link360Profile Condition="'$(Link360Profile)' == ''">Local</Link360Profile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Link360Profile)' == 'Community'">
    <DefineConstants>$(DefineConstants);COMMUNITY_REVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <Content Include="../../models/*" Link="models/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/audio/*" Link="audio/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../native/CameraProbe.cs" Link="CameraProbe.cs" />
    <Compile Include="../native/SmoothMotion.cs" Link="SmoothMotion.cs" />
    <Compile Include="../native/ContinuousMotion.cs" Link="ContinuousMotion.cs" />
    <Compile Include="../native/NativeTracking.cs" Link="NativeTracking.cs" />
    <Compile Include="../native/NativeSpeedMotion.cs" Link="NativeSpeedMotion.cs" />
  </ItemGroup>
  <Target Name="ValidateLink360Profile" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Link360Profile)' != 'Local' And '$(Link360Profile)' != 'Community'" Text="Link360Profile must be Local or Community." />
  </Target>
</Project>
